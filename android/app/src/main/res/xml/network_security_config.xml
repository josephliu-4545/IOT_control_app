<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ESP32 devices use configurable private-network HTTP addresses. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.100.96</domain>
        <domain includeSubdomains="false">172.20.10.4</domain>
        <domain includeSubdomains="false">172.20.10.2</domain>
        <domain includeSubdomains="false">172.20.10.8</domain>
    </domain-config>
</network-security-config>
